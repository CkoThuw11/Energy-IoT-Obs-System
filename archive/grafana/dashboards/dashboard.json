            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Giờ so với bản ghi mới nhất"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
