    {
      "id": 9,
      "type": "stat",
      "title": "Chuyển tải sang Trạm 3",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 0.9 * t3.rated_load - t3.s_h                       AS \"Công suất dư Trạm 3\",\n       greatest(sel.s_h - 0.9 * sel.rated_load, 0)        AS \"Phần vượt 90% của trạm đang chọn\"\nFROM v_station_latest t3, v_station_latest sel\nWHERE t3.station_id = 'TRAM_3' AND sel.station_id = '$station'"
        }
      ],
      "description": "Công suất dư Trạm 3 = 90% × rated_load Trạm 3 − S_H Trạm 3 (cùng đơn vị với S_H). Dư ≥ phần vượt → có thể chuyển tải.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E02F44",
                "value": null
              },
              {
                "color": "#56A64B",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Phần vượt 90% của trạm đang chọn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
