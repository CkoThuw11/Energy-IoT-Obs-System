    {
      "id": 4,
      "type": "trend",
      "title": "load_pct 24 giờ gần nhất (tính theo thời gian dữ liệu)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT max(ts) AS t FROM cleaned)\nSELECT round((extract(epoch FROM c.ts - m.t) / 3600.0)::numeric, 2) AS \"Giờ so với bản ghi mới nhất\",\n       max(c.load_pct) FILTER (WHERE c.station_id = 'TRAM_Y') AS \"Trạm Y\",\n       max(c.load_pct) FILTER (WHERE c.station_id = 'TRAM_2') AS \"Trạm 2\",\n       max(c.load_pct) FILTER (WHERE c.station_id = 'TRAM_3') AS \"Trạm 3\",\n       max(c.load_pct) FILTER (WHERE c.station_id = 'TRAM_4') AS \"Trạm 4\"\nFROM cleaned c, m\nWHERE c.ts > m.t - INTERVAL '24 hours'\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "description": "Trục X: số giờ so với bản ghi mới nhất (0 = hiện tại). Đường nét đứt: ngưỡng Vàng 90%, Đỏ 100%.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#FADE2A",
                "value": 90
              },
              {
                "color": "#E02F44",
                "value": 100
              }
