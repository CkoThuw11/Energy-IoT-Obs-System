    {
      "id": 8,
      "type": "stat",
      "title": "Trạm $station – hiện tại",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last5 AS (\n    SELECT ts, load_pct, ot FROM cleaned\n    WHERE station_id = '$station' ORDER BY ts DESC LIMIT 5),\nx AS (\n    SELECT ts, load_pct, ot, load_pct - lag(load_pct, 4) OVER (ORDER BY ts) AS speed FROM last5)\nSELECT load_pct AS \"load_pct\",\n       ot       AS \"OT\",\n       speed    AS \"Tốc độ\",\n       CASE WHEN speed > 0 THEN (100 - load_pct) / speed * 60 END AS \"TTB\"\nFROM x ORDER BY ts DESC LIMIT 1"
        }
      ],
      "description": "Tốc độ = load_pct hiện tại − load_pct 4 bản ghi trước (%/giờ). TTB = (100 − load_pct) / tốc độ × 60; tải không tăng → không tính.",
      "fieldConfig": {
