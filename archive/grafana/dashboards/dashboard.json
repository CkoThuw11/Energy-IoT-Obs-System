          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT alert_id                         AS \"ID\",\n       station_name                     AS \"Trạm\",\n       severity                         AS \"Mức\",\n       alert_type                       AS \"Loại\",\n       status                           AS \"Trạng thái\",\n       round(load_pct::numeric, 1)      AS \"load_pct (%)\",\n       round(ttb_min::numeric, 0)       AS \"TTB (phút)\",\n       round(speed_pct_h::numeric, 1)   AS \"Tốc độ (%/giờ)\",\n       opened_ts                        AS \"Mở lúc (dữ liệu)\",\n       last_ts                          AS \"Cập nhật (dữ liệu)\",\n       acked_by                         AS \"Người nhận\",\n       acked_at                         AS \"Nhận lúc (giờ thật)\",\n       CASE WHEN status = 'OPEN' THEN 'Tiếp nhận' ELSE '' END AS \"Hành động\"\nFROM v_alert_queue\nWHERE run_id = 'LIVE'\n  AND (status <> 'RESOLVED' OR resolved_ts > (SELECT max(ts) FROM cleaned) - INTERVAL '24 hours')\nORDER BY (status = 'RESOLVED'), severity_rank, ttb_min ASC NULLS LAST, load_pct DESC NULLS LAST, alert_id\nLIMIT 100"
        }
      ],
      "description": "Cảnh báo đang mở (OPEN/ACK) xếp trên; cảnh báo đã đóng trong 24 giờ dữ liệu gần nhất xếp dưới. Bấm \"Tiếp nhận\" để ACK.",
