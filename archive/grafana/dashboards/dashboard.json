          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.group_name                                    AS \"Nhóm\",\n       g.customer_type                                 AS \"Loại\",\n       g.load_share_pct                                AS \"Tỷ trọng (%)\",\n       round((g.load_share_pct / 100 * l.s_h)::numeric, 2) AS \"Tải ước tính\",\n       CASE WHEN g.is_priority THEN 'Ưu tiên giữ điện' ELSE '' END AS \"Ưu tiên\"\nFROM dim_customer_group g\nJOIN v_station_latest l USING (station_id)\nWHERE g.station_id = '$station'\nORDER BY g.is_priority DESC, g.load_share_pct DESC"
        }
      ],
      "description": "Tải ước tính = tỷ trọng × S_H hiện tại. Dữ liệu nhóm khách hàng là SIMULATED.",
