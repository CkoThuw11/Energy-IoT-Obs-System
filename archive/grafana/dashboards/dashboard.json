            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT max(ts) AS t FROM cleaned WHERE station_id = '$station')\nSELECT round((extract(epoch FROM c.ts - m.t) / 3600.0)::numeric, 2) AS \"Giờ so với bản ghi mới nhất\",\n       c.load_pct AS \"load_pct\",\n       c.ot       AS \"OT\"\nFROM cleaned c, m\nWHERE c.station_id = '$station' AND c.ts > m.t - INTERVAL '24 hours'\nORDER BY c.ts"
        }
