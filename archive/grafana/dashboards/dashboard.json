    {
      "id": 3,
      "type": "table",
      "title": "Trạng thái trạm (bản ghi mới nhất)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
