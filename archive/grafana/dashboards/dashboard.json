          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.station_name                                       AS \"Trạm\",\n       count(a.alert_id) FILTER (WHERE a.severity = 'RED')    AS \"Đỏ\",\n       count(a.alert_id) FILTER (WHERE a.severity = 'YELLOW') AS \"Vàng\",\n       count(a.alert_id) FILTER (WHERE a.severity = 'SENSOR') AS \"Lỗi cảm biến\"\nFROM dim_substation s\nLEFT JOIN fact_alert a ON a.station_id = s.station_id AND a.run_id = 'LIVE'\nGROUP BY s.station_id, s.station_name\nORDER BY s.station_id"
        }
      ],
