      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.station_name                AS \"Trạm\",\n       l.ts                          AS \"Thời điểm dữ liệu\",\n       round(l.s_h::numeric, 2)      AS \"S_H\",\n       round(l.rated_load::numeric, 2) AS \"Định mức\",\n       round(l.load_pct::numeric, 1) AS \"load_pct (%)\",\n       round(l.ot::numeric, 1)       AS \"OT (°C)\",\n       CASE WHEN EXISTS (SELECT 1 FROM fact_alert a\n                          WHERE a.run_id = 'LIVE' AND a.station_id = l.station_id\n                            AND a.alert_type = 'SENSOR' AND a.status <> 'RESOLVED')\n            THEN 'SENSOR' ELSE l.load_level END AS \"Mức\"\nFROM v_station_latest l\nORDER BY l.station_id"
        }
      ],
      "description": "Mức = SENSOR (xám) khi trạm đang có cảnh báo lỗi cảm biến chưa đóng.",
